    // Guided Tour variables
    private int tourStep = 0;
    private Stage tourOverlay;
    private Label tourInstructionLabel;
    
    @FXML
    protected void onMenuHelpClick() {
        startGuidedTour();
    }

    private void startGuidedTour() {
        tourStep = 0;
        
        // Create floating instruction window
        tourOverlay = new Stage();
        tourOverlay.initOwner(stage);
        tourOverlay.setTitle("Hướng dẫn sử dụng");
        tourOverlay.setAlwaysOnTop(true);
        
        VBox overlayRoot = new VBox(20);
        overlayRoot.setStyle("-fx-background-color: #2c3e50; -fx-padding: 30;");
        overlayRoot.setAlignment(javafx.geometry.Pos.CENTER);
        
        tourInstructionLabel = new Label();
        tourInstructionLabel.setStyle("-fx-font-size: 16; -fx-text-fill: white; -fx-background-color: #3498db; " +
                                      "-fx-padding: 20; -fx-background-radius: 10; -fx-font-weight: bold;");
        tourInstructionLabel.setWrapText(true);
        tourInstructionLabel.setMaxWidth(450);
        tourInstructionLabel.setMinHeight(120);
        tourInstructionLabel.setAlignment(javafx.geometry.Pos.CENTER);
        
        Button skipButton = new Button("❌ Bỏ qua hướng dẫn");
        skipButton.setOnAction(e -> tourOverlay.close());
        skipButton.setStyle("-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand;");
        
        overlayRoot.getChildren().addAll(tourInstructionLabel, skipButton);
        
        Scene overlayScene = new Scene(overlayRoot, 500, 250);
        tourOverlay.setScene(overlayScene);
        
        // Position at top-right corner
        tourOverlay.setX(stage.getX() + stage.getWidth() - 520);
        tourOverlay.setY(stage.getY() + 20);
        
        setupTourListeners();
        showTourStep();
        tourOverlay.show();
    }
    }

    private void showTourStep() {
        if (tourOverlay == null || !tourOverlay.isShowing()) return;
        
        switch(tourStep) {
            case 0:
                tourInstructionLabel.setText("📝 Bước 1/7: Chọn ký tự phân biệt\n\nHãy click vào một RadioButton bên trái!");
                break;
            case 1:
                tourInstructionLabel.setText("✍️ Bước 2/7: Nhập danh sách tên file\n\nClick vào TextArea và nhập ít nhất 1 ký tự!");
                break;
            case 2:
                tourInstructionLabel.setText("📁 Bước 3/7: Chọn đường dẫn chứa file ảnh gốc\n\nClick vào TextField hoặc nút 'Chọn thư mục'!");
                break;
            case 3:
                tourInstructionLabel.setText("🔍 Bước 4/7: Bấm nút 'Kiểm tra và tìm file'\n\nClick vào nút bên trái!");
                break;
            case 4:
                tourInstructionLabel.setText("📋 Bước 5/7: Xem kết quả tìm kiếm\n\nClick vào bảng kết quả bên phải!");
                break;
            case 5:
                tourInstructionLabel.setText("💾 Bước 6/7: Chọn đường dẫn lưu ảnh\n\nClick vào TextField bên phải!");
                break;
            case 6:
                tourInstructionLabel.setText("✂️ Bước 7/7: Thực hiện lọc ảnh\n\nClick vào nút 'Thực hiện lọc ảnh'!");
                break;
            default:
                Alert done = new Alert(Alert.AlertType.INFORMATION);
                done.setTitle("Hoàn thành");
                done.setHeaderText("Đã hoàn thành hướng dẫn!");
                done.setContentText("Bạn đã sẵn sàng sử dụng ứng dụng!");
                tourOverlay.close();
                done.showAndWait();
                return;
        }
    }

    private void setupTourListeners() {
        // Step 1: Radio button click
        javafx.event.EventHandler<javafx.scene.input.MouseEvent> step1Handler = e -> {
            if (tourStep == 0) {
                tourStep++;
                showTourStep();
            }
        };
        radioBtnNewline.addEventFilter(javafx.scene.input.MouseEvent.MOUSE_CLICKED, step1Handler);
        radioBtnComma.addEventFilter(javafx.scene.input.MouseEvent.MOUSE_CLICKED, step1Handler);
        radioBtnSemicolon.addEventFilter(javafx.scene.input.MouseEvent.MOUSE_CLICKED, step1Handler);
        radioBtnOther.addEventFilter(javafx.scene.input.MouseEvent.MOUSE_CLICKED, step1Handler);
        
        // Step 2: TextArea input
        textAreaFileNameList.textProperty().addListener((obs, old, newVal) -> {
            if (tourStep == 1 && newVal != null && !newVal.trim().isEmpty()) {
                tourStep++;
                showTourStep();
            }
        });
        
        // Step 3: TextField focus
        javafx.event.EventHandler<javafx.scene.input.MouseEvent> step3Handler = e -> {
            if (tourStep == 2) {
                tourStep++;
                showTourStep();
            }
        };
        textFieldFromFolder.addEventFilter(javafx.scene.input.MouseEvent.MOUSE_CLICKED, step3Handler);
        
        // Step 5: TableView click
        listViewFileShowList.setOnMouseClicked(e -> {
            if (tourStep == 4) {
                tourStep++;
                showTourStep();
            }
        });
        
        // Step 6: Destination folder
        textFieldToFolder.setOnMouseClicked(e -> {
            if (tourStep == 5) {
                tourStep++;
                showTourStep();
            }
        });
    }
    
    // Called from onCheckAndFindFileClick
    private void advanceTourIfNeeded() {
        if (tourStep == 3 && tourOverlay != null && tourOverlay.isShowing()) {
            tourStep++;
            showTourStep();
        }
    }
    
    // Called from onFilterAndCopyFileClick
    private void completeTourIfNeeded() {
        if (tourStep == 6 && tourOverlay != null && tourOverlay.isShowing()) {
            tourStep++;
            showTourStep();
        }
    }
    @FXML
    protected void onSelectFromFolderClick() {
        DirectoryChooser directoryChooser = new DirectoryChooser();
        if(!textFieldFromFolder.getText().trim().isEmpty()){
            File f = new File(textFieldFromFolder.getText().trim());
            if(f.exists() && f.isDirectory()){
                directoryChooser.setInitialDirectory(f);
            }
        }

        File selectedDirectory = directoryChooser.showDialog(stage);
        if (selectedDirectory == null) {
            System.out.println("CHƯA CHỌN THƯ MỤC ĐANG LƯU ẢNH");
        } else {
            textFieldFromFolder.setText(selectedDirectory.getAbsolutePath());
        }
    }

    @FXML
    protected void onSelectToFolderClick() {
        DirectoryChooser directoryChooser = new DirectoryChooser();

        if(!textFieldToFolder.getText().trim().isEmpty()){
            File f = new File(textFieldToFolder.getText().trim());
            if(f.exists() && f.isDirectory()){
                directoryChooser.setInitialDirectory(f);
            }
        }

        File selectedDirectory = directoryChooser.showDialog(stage);
        if (selectedDirectory == null) {
            System.out.println("CHƯA CHỌN THƯ MỤC LƯU ẢNH MỚI");
        } else {
            textFieldToFolder.setText(selectedDirectory.getAbsolutePath());
        }
    }


    @FXML
    protected void onCheckAndFindFileClick() {

        fromPath = textFieldFromFolder.getText();
        if (fromPath.isEmpty()) {
            Alert alert = new Alert(Alert.AlertType.WARNING, "Chưa chọn thư mục hình", ButtonType.OK);
            alert.showAndWait();
            return;
        }

        File repo = new File(fromPath);

        if (!repo.isDirectory()) {
            Alert alert = new Alert(Alert.AlertType.WARNING, "Thư mục tìm chọn hình không hợp lệ!", ButtonType.OK);
            alert.showAndWait();
            return;
        }

        ArrayList<File> fileList = new ArrayList<>(List.of(repo.listFiles()));
        String separator = getSeparator();
        if (separator == null) {
            return; // User didn't enter custom separator
        }
        // Escape special regex characters for split
        String escapedSeparator = java.util.regex.Pattern.quote(separator);
        String[] textListFilter = textAreaFileNameList.getText().trim().split(escapedSeparator);
        fileCopyList.clear();
        int stt = 1;

        StringBuilder nameSearchNotFound = new StringBuilder();
        for (int j = 0; j < textListFilter.length; j++) {
            String textFind = textListFilter[j].trim();
            if (textFind.length() < 4) {
                textFind = "0" + textFind;
            }
            File fileRemoveList = null;
            for (int i = 0; i < fileList.size(); i++) {
                File f = fileList.get(i);
                if (f.isFile()) {
                    if (f.getName().toUpperCase().contains(textFind.toUpperCase())) {
                        FileCopy fileCopy = new FileCopy(stt, f, f.getName());
                        stt++;
                        fileCopyList.add(fileCopy);
                        fileRemoveList = f;
                        break;
                    }
                }
            }

            if (fileRemoveList == null) {
                nameSearchNotFound.append("\n");
                nameSearchNotFound.append(textFind);
            } else {
                fileList.remove(fileRemoveList);
            }
        }

        if (fileCopyList.size() == 0) {
            labelErrorMassage.setText("Không tìm thấy file!");
        } else {
            labelErrorMassage.setText("");
        }

        setColumnProperties();
        listViewFileShowList.getItems().clear();
        listViewFileShowList.getItems().addAll(fileCopyList);
        listViewFileShowList.refresh();

        if (!nameSearchNotFound.toString().isEmpty())
            showDialog("Danh sách tên file không tìm thấy",
                    nameSearchNotFound.toString());

        // Advance tour if active
        advanceTourIfNeeded();


    }

    @FXML
    protected void onFilterAndCopyFileClick() {

        toPath = textFieldToFolder.getText();
        if (toPath.isEmpty()) {
            Alert alert = new Alert(Alert.AlertType.WARNING, "Chưa chọn thư mục lưu hình!", ButtonType.OK);
            alert.showAndWait();
            return;
        }

        File rep = new File(toPath);

        if (!rep.isDirectory()) {
            Alert alert = new Alert(Alert.AlertType.WARNING, "Thư mục lưu hình không hợp lệ!", ButtonType.OK);
            alert.showAndWait();
            return;
        }

        labelProgress.setText("");

        progressDialogue();


        labelProgress.setText("     Đã thực hiện thành công");

        listViewFileShowList.getItems().clear();
        listViewFileShowList.getItems().addAll(fileCopyList);
        listViewFileShowList.refresh();



        // Complete tour if active
        completeTourIfNeeded();
    }

    private void progressDialogue() {
        Task copyWorker = createWorker();
        ProgressDialog dialog = new ProgressDialog(copyWorker);
        dialog.initStyle(StageStyle.TRANSPARENT);

        dialog.setGraphic(null);
        //stage.initStyle(StageStyle.TRANSPARENT);
        dialog.initStyle(StageStyle.TRANSPARENT);
        //dialog.setContentText("Files are Uploading");
        //dialog.setTitle("Files Uploading");
        //dialog.setHeaderText("This is demo");
        dialog.setHeaderText(null);
        dialog.setGraphic(null);
        dialog.initStyle(StageStyle.UTILITY);
        new Thread(copyWorker).start();
        dialog.showAndWait();
    }


    public Task createWorker() {
        return new Task() {
            @Override
            protected Object call() throws Exception {
                String fileCopyError = "";

                for (int i = 0; i < fileCopyList.size(); i++) {
                    FileCopy fileCopy = fileCopyList.get(i);
                    File f = fileCopy.getFile();

                    try {
                        Files.copy(f.toPath(),
                                (new File(toPath + "\\" + f.getName())).toPath(),
                                StandardCopyOption.REPLACE_EXISTING);


                        double percent = 1.0 * i / fileCopyList.size() * 100;
//                        labelProgress.setText();
                        fileCopy.setStatus("Đã copy");

                        Thread.sleep(100);
                        updateMessage("   Đang thực hiện (" + (int) percent + "%) Copy file " + f.getName());
                        updateProgress(i + 1, fileCopyList.size());

                    } catch (IOException e) {
                        fileCopyError += "\n";
                        fileCopyError += f.getName();

                        Alert alert = new Alert(Alert.AlertType.WARNING, e.getMessage(), ButtonType.OK, ButtonType.CANCEL);
                        alert.showAndWait();

                        if (alert.getResult() == ButtonType.CANCEL) {
                            break;
                        }

                        throw new RuntimeException(e);
                    }
                }

                if (!fileCopyError.isEmpty())
                    showDialog("Danh sách file copy thất bại",
                            fileCopyError);

                return true;
            }
        };
    }

    private void setColumnProperties() {
        colStt.setCellValueFactory(new PropertyValueFactory<FileCopy, Integer>("stt"));
        filename.setCellValueFactory(new PropertyValueFactory<FileCopy, String>("filename"));
        status.setCellValueFactory(new PropertyValueFactory<FileCopy, String>("status"));
    }

    private String getSeparator() {
        if (radioBtnNewline.isSelected()) {
            return "\n";
        } else if (radioBtnComma.isSelected()) {
            return ",";
        } else if (radioBtnSemicolon.isSelected()) {
            return ";";
        } else if (radioBtnOther.isSelected()) {
            String custom = textFieldOtherSeparator.getText();
            if (custom.isEmpty()) {
                Alert alert = new Alert(Alert.AlertType.WARNING, "Vui lòng nhập ký tự phân biệt cho tuỳ chọn 'Khác'", ButtonType.OK);
                alert.showAndWait();
                return null;
            }
            return custom;
        }
        return "\n"; // Default to newline
    }

    @Override
    public void initialize(URL location, ResourceBundle resources) {
        setColumnProperties();
        
        // Make filename column responsive
        listViewFileShowList.setColumnResizePolicy(TableView.CONSTRAINED_RESIZE_POLICY);
        filename.setPrefWidth(500.0);
        filename.setMinWidth(100.0);
        
        // Bind filename column width to grow with table
        filename.prefWidthProperty().bind(
            listViewFileShowList.widthProperty()
                .subtract(colStt.getPrefWidth())
                .subtract(status.getPrefWidth())
                .subtract(4) // Account for scrollbar and padding
        );

        // First-run: show Help Splash, then About; otherwise: just show About
        // First-run: show About, then Guided Tour; otherwise: just show About
        java.util.prefs.Preferences prefs = java.util.prefs.Preferences.userNodeForPackage(HelloController.class);
        boolean firstRun = prefs.getBoolean("firstRun", true);
        if (firstRun) {
            Platform.runLater(() -> {
                onMenuAboutClick();
                // After About closes, show Guided Tour
                Platform.runLater(() -> {
                    Alert askTour = new Alert(Alert.AlertType.CONFIRMATION);
                    askTour.setTitle("Hướng dẫn sử dụng");
                    askTour.setHeaderText("Bạn có muốn xem hướng dẫn sử dụng không?");
                    askTour.setContentText("Hướng dẫn tương tác sẽ giúp bạn làm quen với ứng dụng.");
                    Optional<ButtonType> result = askTour.showAndWait();
                    if (result.isPresent() && result.get() == ButtonType.OK) {
                        startGuidedTour();
                    }
                });
                prefs.putBoolean("firstRun", false);
            });
        } else {
            Platform.runLater(this::onMenuAboutClick);
        }
    }

    private void showDialog(String title,String text) {
        Dialog<Pair<String, String>> dialog = new Dialog<>();
        dialog.setTitle(title);

        // Set the button types.
        ButtonType loginButtonType = new ButtonType("OK", ButtonBar.ButtonData.OK_DONE);
        dialog.getDialogPane().getButtonTypes().addAll(loginButtonType);

        GridPane gridPane = new GridPane();
        gridPane.setHgap(10);
        gridPane.setVgap(10);
        gridPane.setPadding(new Insets(20, 150, 10, 10));

        TextArea from = new TextArea();
        from.setText(text);

        gridPane.add(from, 0, 0);

        dialog.getDialogPane().setContent(gridPane);

        // Request focus on the username field by default.
        Platform.runLater(() -> from.requestFocus());

//        // Convert the result to a username-password-pair when the login button is clicked.
//        dialog.setResultConverter(dialogButton -> {
//            if (dialogButton == loginButtonType) {
//                return new Pair<>(from.getText(), to.getText());
//            }
//            return null;
//        });

        Optional<Pair<String, String>> result = dialog.showAndWait();
    }

    public class FileCopy {
        private File file;
        private int stt;
        private String filename;
        private String status;

        public FileCopy() {
        }

        public FileCopy(int stt, File file, String filename) {
            this.stt = stt;
            this.file = file;
            this.filename = filename;
            this.status = "Đã tìm thấy";
        }

        public int getStt() {
            return this.stt;
        }

        public void setStt(int stt) {
            this.stt = stt;
        }

        public File getFile() {
            return this.file;
        }

        public void setFile(File file) {
            this.file = file;
        }

        public String getFilename() {
            return filename;
        }

        public void setFilename(String filename) {
            this.filename = filename;
        }

        public String getStatus() {
            return status;
        }

        public void setStatus(String status) {
            this.status = status;
        }
    }
}